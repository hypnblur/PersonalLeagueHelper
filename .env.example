# Copy to .env for local personal configuration.

# AI (default: Gemini). Also supports OpenAI-compatible providers (OpenAI/OpenRouter/Groq/Ollama/LM Studio).
AI_PROVIDER=gemini
# AI_API_KEY=                  # or GEMINI_API_KEY / OPENAI_API_KEY depending on provider
AI_MODEL=gemini-3.8-flash
# AI_BASE_URL=                 # e.g. http://localhost:11434/v1 (Ollama) or https://openrouter.ai/api/v1
# AI_FALLBACK_MODEL=gemini-2.0-flash
AI_TIMEOUT=60

# Legacy Gemini vars (still supported)
GEMINI_API_KEY=
RECAP_MODEL=gemini-3.8-flash

WEB_HOST=127.0.0.1
WEB_PORT=8080
OPEN_BROWSER=1
SAFE_RUNE_IMPORT=1
RUNE_PAGE_PREFIX=LA:
LCU_POLL_INTERVAL=2
# COMPANION_DB_PATH=./data/companion.db
